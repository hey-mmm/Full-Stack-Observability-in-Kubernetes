              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "service": true,
              "uid": true
            },
            "indexByName": {},
            "renameByName": {
              "image": "image（含版本 tag）",
              "node": "node",
              "pod": "pod"
            }
          }
        }
      ],
      "type": "table"
